  "editor.tokenColorCustomizations": {
    
     
    "comments": "#616E88",
    "strings": "#9DB28F",
    "numbers": "#A78FA8",
    "keywords": "#81A1C1",
    "functions": "#86B3C0",
    "variables": "#34579a",
    "types": "#8FBCBB",
    
    "textMateRules": [
      
      { "scope": ["support.type.python", "support.type.builtin.python", "storage.type.python", "meta.function-call.python support.type.python"], "settings": { "foreground": "#7FB5A8" } },
      { "scope": ["constant.numeric", "constant.numeric.integer", "constant.numeric.float", "constant.numeric.decimal.python"], "settings": { "foreground": "#69c35fb1" } },
      { "scope": ["entity.name.function", "support.function", "support.function.builtin.python", "meta.function-call.python", "meta.function-call.generic.python"], "settings": { "foreground": "#a98edc" } },
      { "scope": ["string", "string.quoted", "string.quoted.docstring", "string.interpolated"], "settings": { "foreground": "#8aa2d9" } },
      { "scope": ["variable.other.readwrite"], "settings": {"foreground": "#d0bcaabd"}},
      { "scope": ["keyword.control.import.python"], "settings": { "foreground": "#a79393"}}, 
      { "scope": ["comment", "punctuation.definition.comment"], "settings": { "fontStyle": "italic" } },
      { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#81A1C1" } },
      { "scope": ["constant.language", "support.constant"], "settings": { "foreground": "#81A1C1" } },
      { "scope": ["entity.name.class", "entity.name.type", "support.class"], "settings": { "foreground": "#8FBCBB" } },
      { "scope": ["variable.parameter"], "settings": { "foreground": "#C7CEDB", "fontStyle": "italic" } },
      { "scope": ["entity.name.tag"], "settings": { "foreground": "#81A1C1" } },
      { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#8FBCBB" } },
      { "scope": ["support.type.property-name", "meta.object-literal.key"], "settings": { "foreground": "#A9C1C9" } },
      { "scope": ["invalid"], "settings": { "foreground": "#B5636C" } },
      { "scope": ["markup.heading"], "settings": { "foreground": "#86B3C0", "fontStyle": "bold" } },
      { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#9DB28F" } }
    ]
